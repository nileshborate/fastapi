# Copy this file to .env and fill in real values.  NEVER commit .env
APP_NAME="Course Hub API"
ENVIRONMENT=dev
DEBUG=true
SHOW_DOCS=true
API_KEY=change-me
DATABASE_URL=sqlite:///./coursehub.db
MAX_UPLOAD_MB=5
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]
LOG_FILE=app.log
EMAIL_DELAY_SECONDS=3
LOAD_SEED_DATA=true
SEED_FILE=data/courses.json
BACKUP_FILE=data/backup_courses.json
