# Copy this file to .env.  NEVER commit .env
DATABASE_URL=sqlite+aiosqlite:///./school.db
# PostgreSQL: DATABASE_URL=postgresql+asyncpg://coursehub:coursehub@localhost:5432/coursehub
DB_ECHO=false
# make a real secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars-or-more
ACCESS_TOKEN_MINUTES=15
# development | production   (production: no /docs, HTTPS only, HSTS)
ENVIRONMENT=development
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
CORS_ORIGINS=["http://localhost:3000"]
MAX_BODY_BYTES=16384
LOGIN_LIMIT=5
LOGIN_WINDOW_SECONDS=60
